{
  "name": "whatsapp-ai-digest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,ext -c cyan,magenta \"pnpm --filter @wad/server dev\" \"pnpm --filter @wad/extension dev\"",
    "start": "pnpm --filter @wad/server start",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "tray:build": "dotnet build apps/tray-windows -c Release -o apps/tray-windows/dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
