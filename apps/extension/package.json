{
  "name": "@wad/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n pages,content \"vite build --watch --mode development\" \"vite build --watch --mode development -c vite.content.config.ts\"",
    "build": "vite build && vite build -c vite.content.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@wad/shared": "workspace:*",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
