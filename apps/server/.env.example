# Get a free key at https://console.groq.com/keys — never put it in the Chrome extension.
GROQ_API_KEY=

# Model used for summarization (check availability with: pnpm --filter @wad/server check-model)
GROQ_MODEL=openai/gpt-oss-20b

# AI provider: groq (default) | openai | ollama | gemini — all via OpenAI-compatible endpoints.
AI_PROVIDER=groq
# Only for non-Groq providers:
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# Local server port (binds to 127.0.0.1 only).
PORT=3001

# Comma-separated Chrome extension IDs allowed to call the API.
# The bundled extension has a fixed ID (pinned via the manifest "key"): fjldfeefkijllcoohbgfdodnkoeoedkg
ALLOWED_EXTENSION_IDS=fjldfeefkijllcoohbgfdodnkoeoedkg

# Max characters of message text per AI request; larger chats are split into batches.
# Groq's free tier allows ~8K tokens/minute for gpt-oss models — keep this modest.
BATCH_MAX_CHARS=12000

# Log level: fatal | error | warn | info | debug (message contents are never logged).
LOG_LEVEL=info
